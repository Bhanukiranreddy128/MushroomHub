# =============================================================================
# MushroomHub Environment Configuration Template
# =============================================================================
# IMPORTANT:
# - Copy this file to '.env' for local development or configure these variables
#   directly in your deployment platform (e.g., Render, Railway, AWS).
# - NEVER commit your real '.env' file or production credentials to GitHub.
# - Windows System Environment Variables do NOT automatically transfer to Render;
#   you must manually set them in the Render Dashboard under Environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Aiven Cloud PostgreSQL)
# -----------------------------------------------------------------------------
# Full JDBC connection URL for PostgreSQL. Include sslmode=require for Aiven.
DB_URL=jdbc:postgresql://<aiven-db-host>:<port>/defaultdb?sslmode=require

# Database authentication credentials
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_db_password_here

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode / Live Mode)
# -----------------------------------------------------------------------------
# Razorpay Key ID (Public identifier used for payment orders & client checkout)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret (Private secret for HMAC-SHA256 signature verification)
# WARNING: NEVER expose this secret in the frontend or commit to GitHub!
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# -----------------------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email Service (Gmail OTP)
# -----------------------------------------------------------------------------
# Brevo API Key for real-time 6-digit OTP delivery
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Verified sender email registered with Brevo
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Display name for transactional emails
BREVO_SENDER_NAME=MushroomHub Security

# -----------------------------------------------------------------------------
# Security & JWT Token Authentication
# -----------------------------------------------------------------------------
# 256-bit secret key used to sign and verify HMAC-SHA256 JWT tokens
# Generate a strong, random 64+ character string for production
JWT_SECRET=your_jwt_strong_random_secret_key_minimum_64_characters_here

# -----------------------------------------------------------------------------
# Server Runtime (Spring Boot Backend)
# -----------------------------------------------------------------------------
# Server port (Render automatically provides PORT in production; defaults to 8080 locally)
PORT=8080

# -----------------------------------------------------------------------------
# React Frontend (Optional / Deployment)
# -----------------------------------------------------------------------------
# Base URL for backend APIs when deploying frontend to Vercel/Netlify/Render
# Note: Never put database credentials or Razorpay Key Secret in VITE_ variables!
VITE_API_BASE_URL=http://localhost:8080/api
